PORT=8000
DATABASE_URL=sqlite:///./pulseai.db
SECRET_KEY=local-dev-secret-key-pulseai-minimum-32-chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["*"]

# Groq AI settings (leave key empty by default; set in .env when available)
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
